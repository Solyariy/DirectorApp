# Can be retrieved with `ipconfig` on windows or `ip a` on Linux
DEVICE_LAN_IP=
BROADCAST=

# Use src/inverter_service/detector.py
INVERTER_LOGGER_IP=
INVERTER_LOGGER_SERIAL=

INVERTER_MANAGER_CONNECTION_TTL_MINUTES=2

# PV array, for the irradiance proof of concept (`compare_pv_estimate`)
PV_SITE_LATITUDE=
PV_SITE_LONGITUDE=
PV_SITE_TILT_DEG=
# Compass azimuth: 180 = south, 90 = east, 270 = west
PV_SITE_AZIMUTH_DEG=
PV_SITE_PEAK_POWER_W=
PV_SITE_PERFORMANCE_RATIO=0.8
