# Django: generate a key with
# uv run python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO

# Can be retrieved with `ipconfig` on windows or `ip a` on Linux
DEVICE_LAN_IP=
BROADCAST=

# Use src/inverter_service/detector.py
INVERTER_LOGGER_IP=
INVERTER_LOGGER_SERIAL=

INVERTER_MANAGER_CONNECTION_TTL_MINUTES=2

# inverter-worker container: collect_energy_snapshot every N minutes (1-59)
INVERTER_WORKER_CRON_CYCLE_MINUTES=5

# Shared Postgres (compose.yaml `db` service)
POSTGRES_DB=director
POSTGRES_USER=director
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5444

# Browser origins allowed to call /api/ (comma-separated, scheme://host[:port])
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
