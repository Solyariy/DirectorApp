erDiagram
    JOB_TYPE ||--o{ JOB : has
    JOB ||--o{ JOB_EVENT : logs
    POLICY |o--o{ REGISTERED_APP : governs
    POLICY ||--o{ POLICY_RULE_RELATION : combines
    RULE ||--o{ POLICY_RULE_RELATION : "used by"

    JOB_TYPE {
        int id PK
        string name UK
        float avg_kwh
        int avg_duration_s
        int runs_count
    }

    JOB {
        int id PK
        string name
        int job_type_id FK
        json payload
        string mode "defer|opportunistic|force"
        int priority
        string status "queued|running|done|failed|cancelled"
        datetime deadline
        float predicted_kwh
        float actual_kwh
        string reason
        datetime created_at
        datetime started_at
        datetime finished_at
    }

    JOB_EVENT {
        int id PK
        int job_id FK
        datetime ts
        string kind
        string message
    }

    ENERGY_SNAPSHOT {
        int id PK
        datetime ts
        int solar_w
        int load_w
        int battery_pct
        int grid_w
        float pv1_voltage_v "nullable, per PV string 1..2"
        float pv1_current_a
        int pv1_power_w
        int battery_max_charge_current_a
        string source
    }

    REGISTERED_APP {
        int id PK
        string name UK
        string description
        string token_hash UK "token shown once"
        int policy_id FK "nullable, one policy per app"
        datetime created_at
        datetime last_seen_at
    }

    POLICY {
        int id PK
        string name UK
        string description
        bool is_active "policy switch"
        string operator "and|or over its rules"
        int max_concurrent_jobs
        datetime created_at
        datetime updated_at
    }

    POLICY_RULE_RELATION {
        int id PK
        int policy_id FK "unique with rule_id"
        int rule_id FK
        bool is_active "link switch"
        datetime created_at
    }

    RULE {
        int id PK
        string name UK
        string description
        json combination "expression over the energy reading"
        bool is_active "rule switch"
        datetime created_at
        datetime updated_at
    }

    classDef jobType fill:#fdf2fd,stroke:#e879f9
    classDef job fill:#f0fdfa,stroke:#2dd4bf
    classDef jobEvent fill:#fff7ed,stroke:#fb923c
    classDef energy fill:#ecfeff,stroke:#22d3ee
    classDef policy fill:#f0fdf4,stroke:#4ade80
    classDef app fill:#f5f3ff,stroke:#a78bfa
    classDef edge fill:#fefce8,stroke:#facc15
    classDef rule fill:#fef2f2,stroke:#f87171

    class JOB_TYPE jobType
    class JOB job
    class JOB_EVENT jobEvent
    class ENERGY_SNAPSHOT energy
    class POLICY policy
    class REGISTERED_APP app
    class POLICY_RULE_RELATION edge
    class RULE rule
